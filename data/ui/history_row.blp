using Gtk 4.0;

template $ClipperinoHistoryRow : Box {
  orientation: horizontal;
  spacing: 12;
  margin-start: 12;
  margin-end: 8;
  margin-top: 10;
  margin-bottom: 10;

  Image icon {
    icon-name: "text-x-generic-symbolic";
    pixel-size: 16;
    valign: center;
    styles ["clip-kind-icon"]
  }

  Picture picture {
    visible: false;
    content-fit: cover;
    width-request: 52;
    height-request: 52;
    valign: center;
    styles ["clip-thumbnail"]
  }

  Box {
    orientation: vertical;
    spacing: 2;
    hexpand: true;
    valign: center;

    Label preview {
      xalign: 0;
      ellipsize: end;
      lines: 2;
      wrap: true;
      wrap-mode: word_char;
    }

    Label time {
      xalign: 0;
      styles ["caption", "dim-label"]
    }
  }

  Image pin_icon {
    icon-name: "view-pin-symbolic";
    visible: false;
    valign: center;
    styles ["accent"]
  }

  MenuButton more_button {
    icon-name: "view-more-symbolic";
    valign: center;
    tooltip-text: _("More Actions");
    styles ["flat", "circular"]
  }
}
