<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.djshiye.Clipperino</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Clipperino</name>
  <summary>Clipboard history with emoji and symbols</summary>
  <description>
    <p>Clipperino keeps a history of the text and images you copy and lets you paste any of them back into the app you were using with a single keystroke. It also offers a searchable emoji and symbol picker.</p>
    <ul>
      <li>Runs in the background and records clipboard changes through GNOME's portals</li>
      <li>Open it anywhere with Super+Shift+V, search, and press Enter to paste</li>
      <li>Pin favourites, delete with undo, and keep images as well as text</li>
      <li>Emoji browser using GNOME's localized emoji names, plus a symbol browser</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.djshiye.Clipperino.desktop</launchable>
  <provides>
    <binary>clipperino</binary>
  </provides>
  <url type="homepage">https://github.com/djshiye/Clipperino</url>
  <url type="bugtracker">https://github.com/djshiye/Clipperino/issues</url>
  <url type="vcs-browser">https://github.com/djshiye/Clipperino</url>
  <developer id="io.github.djshiye">
    <name>djshiye</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#62a0ea</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/djshiye/clipperino/main/data/screenshots/history.png</image>
      <caption>Clipboard history grouped by day, with link, colour and image previews</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/djshiye/clipperino/main/data/screenshots/images.png</image>
      <caption>The Images filter shows copied pictures as a gallery</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/djshiye/clipperino/main/data/screenshots/emoji.png</image>
      <caption>Emoji picker with categories and search</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.3.2" date="2026-09-29">
      <description>
        <p>Fixes recording staying off after GNOME ended the clipboard permission session: Clipperino now reconnects on its own, and the Grant Access button works again. Adds a Flatpak build and screenshots for software centres.</p>
      </description>
    </release>
    <release version="1.3.1" date="2026-09-29">
      <description>
        <p>A tidier status icon menu: fewer and shorter rows, no section headers, and icons only for pinned clips and images. Image thumbnails are cropped to fill their icon, and images are labelled by the time they were copied. Clear History moved to Preferences only.</p>
      </description>
    </release>
    <release version="1.3.0" date="2026-09-29">
      <description>
        <p>Images are easier to find and recognise: an Images filter shows them as a gallery, and in the full list each image is a large card instead of a small thumbnail. The preview pane and details view show the full-size image, and transparent images sit on a checkerboard.</p>
        <p>The history is grouped into Today, Yesterday, Last 7 Days and Earlier. Links, email addresses, code and colour codes get their own icons, colour codes show a swatch, and the status icon menu tells images apart by the time they were copied.</p>
      </description>
    </release>
    <release version="1.2.0" date="2026-09-29">
      <description>
        <p>Pause recording, and optionally delete unpinned clips after a day, a week, 30 or 90 days. Copied files paste as files again, search finds text anywhere in a clip, and the same image copied from two apps is kept once. The status icon menu shows your actual shortcut and a Pause Recording toggle.</p>
        <p>Fixes: row menu actions could target the wrong item after the list changed, the Show Status Icon switch did nothing, and recording stopped silently when GNOME ended the permission session.</p>
      </description>
    </release>
    <release version="1.1.0" date="2026-09-29">
      <description>
        <p>Clipped is now called Clipperino. History carries over automatically. The tray menu opens immediately on click.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-09-28">
      <description>
        <p>Complete rewrite in Rust with GTK 4 and libadwaita for GNOME on Wayland.</p>
      </description>
    </release>
  </releases>
</component>
